stroke=\"#073984\" stroke-width=\"1\"/><foreignObject id=\"H-HXS_it_equip_06\" x=\"1620\" y=\"320\" width=\"200\" height=\"74\"><div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"width:100%;height:100%;\"><select id=\"S-HXS_it_equip_06\" style=\"width:100%;height:100%;font-family:Microsoft YaHei,Roboto-Regular;font-size:22px;\"></select></div></foreignObject></g><rect x=\"40\" y=\"520\" width=\"1840\" height=\"140\" fill=\"#F4F5F7\" stroke=\"#D0D0D0\" stroke-width=\"1\" rx=\"6\"/><text x=\"58\" y=\"554\" font-family=\"Microsoft YaHei, Roboto-Regular\" font-size=\"24\" fill=\"#1D1D1D\" text-anchor=\"start\" font-weight=\"bold\">状态图例</text><text x=\"1862\" y=\"552\" font-family=\"Microsoft YaHei, Roboto-Regular\" font-size=\"16\" fill=\"#757575\" text-anchor=\"end\">§4.3.6 设备位号 + 状态颜色</text><rect x=\"80\" y=\"570\" width=\"40\" height=\"40\" fill=\"#2E7D32\" stroke=\"none\" stroke-width=\"1\" rx=\"6\"/><text x=\"138\" y=\"600\" font-family=\"Microsoft YaHei, Roboto-Regular\" font-size=\"22\" fill=\"#1D1D1D\" text-anchor=\"start\">绿 = 运行</text><rect x=\"380\" y=\"570\" width=\"40\" height=\"40\" fill=\"#9E9E9E\" stroke=\"none\" stroke-width=\"1\" rx=\"6\"/><text x=\"438\" y=\"600\" font-family=\"Microsoft YaHei, Roboto-Regular\" font-size=\"22\" fill=\"#1D1D1D\" text-anchor=\"start\">灰 = 待机</text><rect x=\"680\" y=\"570\" width=\"40\" height=\"40\" fill=\"#C62828\" stroke=\"none\" stroke-width=\"1\" rx=\"6\"/><text x=\"738\" y=\"600\" font-family=\"Microsoft YaHei, Roboto-Regular\" font-size=\"22\" fill=\"#1D1D1D\" text-anchor=\"start\">红 = 故障</text><rect x=\"980\" y=\"570\" width=\"40\" height=\"40\" fill=\"#F9A825\" stroke=\"none\" stroke-width=\"1\" rx=\"6\"/><text x=\"1038\" y=\"600\" font-family=\"Microsoft YaHei, Roboto-Regular\" font-size=\"22\" fill=\"#1D1D1D\" text-anchor=\"start\">黄 = 切换</text><text x=\"80\" y=\"660\" font-family=\"Microsoft YaHei, Roboto-Regular\" font-size=\"18\" fill=\"#757575\" text-anchor=\"start\">每个设备位为一个 HtmlSelect 组件，绑定 mes.equipment.*.status，实时显示/切换设备状态。</text></g></svg>"
      }
    ],

  "scripts": [
    {
      "id": "s_oee_calc",
      "name": "OEE计算",
      "mode": "server",
      "scheduling": {
        "mode": "interval",
        "interval": 60000,
        "schedules": []
      },
      "code": "// ===== OEE 计算 =====\n// 命名(附录 A.1): 脚本 id = s_<功能>_<动作> = s_oee_calc; 脚本名 = <功能>计算 = OEE 计算\n// 输入: mes.wo.planned, mes.wo.completed, mes.defect.count, mes.defect.inspected\n// 输出: mes.wo.rate, mes.defect.rate, mes.oee.availability/performance/quality/score\n//\n// 说明: 为满足规格书 C-4（零随机数、两次截图完全一致），本脚本不读取任何系统时间，\n//       班次时长与理论节拍均为固定常量。若现场需要按真实班次计算性能率，\n//       可在二次开发时改用内置函数 $getTag(id)（见手册第 6 章脚本 API）。\n\n// 错误处理(附录 A.2): 用 || 0 防御 null\nconst planned = $getTag('mes.wo.planned') || 0;\nconst completed = $getTag('mes.wo.completed') || 0;\nconst defect = $getTag('mes.defect.count') || 0;\nconst inspected = $getTag('mes.defect.inspected') || 0;\n\n// 错误处理(附录 A.2): 关键量为空时 console.log 后提前 return，避免除零与脏数据\nif (!planned) {\n  console.log('OEE 计算跳过: mes.wo.planned 为空或 0');\n  return;\n}\n\n// 固定常量: 班次时长(秒) 与 理论节拍(秒/件)\nconst SHIFT_SECONDS = 28800;\nconst CYCLE_TIME = 120;\n\n// 达成率 = 完工 / 计划\nconst rate = Math.min(1, completed / planned);\n// 可用率 = 运行时间 / 班次时长（此处用达成率近似，真实场景从设备状态 tag 统计）\nconst availability = rate;\n\n// 性能率 = 理论节拍 / 实际节拍\nconst actualRate = completed > 0 ? SHIFT_SECONDS / completed : CYCLE_TIME;\nconst performance = Math.min(1, CYCLE_TIME / Math.max(CYCLE_TIME, actualRate));\n\n// 合格率 = 1 - 缺陷率\nconst defectRate = inspected > 0 ? defect / inspected : 0;\nconst quality = Math.max(0, 1 - defectRate);\n\n// OEE = 可用率 x 性能率 x 合格率（规格书第 8 节验收口径）\nconst oee = availability * performance * quality;\n\n$setTag('mes.wo.rate', (rate * 100).toFixed(2));\n$setTag('mes.defect.rate', defectRate.toFixed(4));\n$setTag('mes.oee.availability', availability.toFixed(4));\n$setTag('mes.oee.performance', performance.toFixed(4));\n$setTag('mes.oee.quality', quality.toFixed(4));\n$setTag('mes.oee.score', oee.toFixed(4));\n\n// 性能(附录 A.3): DAQ 写入不在任何循环内。调度 interval=60000ms，单次执行 1 次 DAQ 写入\n// -> 稳态 1 次/分钟，正好等于 A.3 上限，不超限。\n\n// 性能(附录 A.3): 本次执行日志 1 行（正常路径）或 1 行（提前返回），远小于 10 行上限。\n// 单次执行耗时: 纯算术 + 6 次 tag 写 + 1 次 DAQ 写，远小于 30 秒超时。\nconsole.log('OEE: A=' + availability.toFixed(4) + ' P=' + performance.toFixed(4) + ' Q=' + quality.toFixed(4) + ' OEE=' + oee.toFixed(4));"
    },
    {
      "id": "s_energy_agg",
      "name": "能耗汇总",
      "mode": "server",
      "scheduling": {
        "mode": "interval",
        "interval": 300000,
        "schedules": []
      },
      "code": "// ===== 能耗汇总 =====\n// 命名(附录 A.1): 脚本 id = s_<功能>_<动作> = s_energy_agg; 脚本名沿用规格书第 10 节清单「能耗汇总」\n// 输入: mes.energy.kwh / water / gas / steam\n// 输出: mes.carbon.estimate, mes.energy.cost\n\n// 峰谷平电价常量表（元/kWh）\nconst tariff = {\n  peak:   0.8924,  // 尖峰 14:00-19:00\n  normal: 0.6874,  // 平时 08:00-14:00, 19:00-22:00\n  valley: 0.3646   // 谷时 23:00-07:00\n};\n\n// 碳排因子（kg CO2 / kWh）\nconst CARBON_FACTOR = 0.58;\n\n// 错误处理(附录 A.2): 用 || 0 防御 null\nconst kwh = $getTag('mes.energy.kwh') || 0;\nconst water = $getTag('mes.energy.water') || 0;\nconst gas = $getTag('mes.energy.gas') || 0;\nconst steam = $getTag('mes.energy.steam') || 0;\n\n// 错误处理(附录 A.2): 关键量全为空时 console.log 后提前 return，不写无意义的 0 到历史库\nif (!kwh && !water && !gas && !steam) {\n  console.log('能耗汇总跳过: 四个能耗 tag 均为空');\n  return;\n}\n\n// 碳排 = 电耗 x 碳排因子, kg -> t（规格书第 8 节验收口径）\nconst carbon = kwh * CARBON_FACTOR / 1000;\n$setTag('mes.carbon.estimate', carbon.toFixed(2));\n\n// 电费（简化: 总电量 x 三段电价均值）\nconst avgPrice = (tariff.peak + tariff.normal + tariff.valley) / 3;\nconst elecCost = kwh * avgPrice;\n$setTag('mes.energy.cost', elecCost.toFixed(2));\n\n// 性能(附录 A.3): DAQ 写入全部平铺在函数体，不在任何循环内。\n// 调度 interval=300000ms（5 分钟一次），单次执行 5 次 DAQ 写入 -> 稳态 1 次/分钟，不超限。\n\n// 性能(附录 A.3): 本次执行日志 1 行，远小于 10 行上限；纯算术，远小于 30 秒超时。\nconsole.log('能耗汇总: 电=' + kwh + 'kWh 水=' + water + 'm3 气=' + gas + 'm3 汽=' + steam + 'kg 碳排=' + carbon.toFixed(2) + 't 电费=' + elecCost.toFixed(2) + '元');"
    },
    {
      "id": "s_shift_report",
      "name": "班次产量汇总",
      "mode": "server",
      "scheduling": {
        "mode": "scheduling",
        "interval": 0,
        "schedules": [
          {
            "type": 0,
            "days": ["mon", "tue", "wed", "thu", "fri"],
            "time": "08:00",
            "hour": 8,
            "minute": 0
          }
        ]
      },
      "code": "// ===== 班次产量汇总 =====\n// 命名(附录 A.1): 脚本 id = s_<功能>_<动作> = s_shift_report; 脚本名沿用规格书第 10 节清单「班次产量汇总」\n// 调度: 每周一至周五 08:00 触发（早班交接）\n// 输入: mes.wo.completed / planned / wip, mes.defect.count / inspected, mes.shift\n// 输出: 服务器日志（报表引擎按 Reports 配置的 queries 自动采集历史值）\n\n// 错误处理(附录 A.2): 用 || 0 防御 null；字符串量给默认值\nconst completed = $getTag('mes.wo.completed') || 0;\nconst planned = $getTag('mes.wo.planned') || 0;\nconst wip = $getTag('mes.wo.wip') || 0;\nconst defect = $getTag('mes.defect.count') || 0;\nconst inspected = $getTag('mes.defect.inspected') || 0;\nconst shift = $getTag('mes.shift') || '未定义';\n\n// 错误处理(附录 A.2): 计划与完工都为空时 console.log 后提前 return，不产生空报表\nif (!planned && !completed) {\n  console.log('班次报告跳过: mes.wo.planned 与 mes.wo.completed 均为空');\n  return;\n}\n\nconst rate = planned > 0 ? (completed / planned) : 0;\nconst defectRate = inspected > 0 ? (defect / inspected) : 0;\n\n// 性能(附录 A.3): 本脚本为例外调度（每天 1 次），单次执行 1 次 DAQ 写入 -> 1 次/天，远低于 1 次/分钟上限。\n\n// 性能(附录 A.3): 本次执行日志 1 行（正常路径）或 1 行（提前返回），远小于 10 行上限；纯算术，远小于 30 秒超时。\nconsole.log('班次报告[' + shift + ']: 完工=' + completed + ', 计划=' + planned + ', 在制=' + wip\n  + ', 缺陷=' + defect + ', 达成率=' + (rate * 100).toFixed(1) + '%', ' 缺陷率=' + (defectRate * 100).toFixed(2) + '%');\n\n// 报表引擎会自动采集以上 tag 的历史值，见 server.reports: r_000000000100 / r_000000000101"
    }
  ],

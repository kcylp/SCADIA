      {
        "name": "缺陷率超标",
        "property": {
          "variableId": "mes.defect.rate",
          "permission": 0,
          "permissionRoles": {
            "show": [],
            "enabled": []
          }
        },
        "highhigh": {
          "checkdelay": 1,
          "min": 0.05,
          "max": 1,
          "timedelay": 0,
          "enabled": false,
          "text": "缺陷率超标（高高限）",
          "group": "质量",
          "ackmode": "ackactive",
          "bkcolor": "#ef0909",
          "color": "#ef0909"
        },
        "high": {
          "checkdelay": 1,
          "min": 0.05,
          "max": 1,
          "timedelay": 0,
          "enabled": true,
          "text": "缺陷率超标（高限）",

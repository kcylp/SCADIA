  "reports": [
    {
      "id": "r_000000000100",
      "name": "日报_产量",
      "receiver": "demo-report@example.invalid",
      "scheduling": "day",
      "docproperty": {
        "pageSize": "A4",
        "pageOrientation": "portrait",
        "pageMargins": [
          60,
          40,
          40,
          40
        ],
        "fontName": "Helvetica"
      },
      "content": {
        "items": [
          {
            "type": "text",
            "text": "日报_产量（MES/EMS 模板）",
            "size": 16,
            "align": "center"
          },
          {
            "type": "table",
            "columns": [
              {
                "type": 1,
                "tag": {
                  "id": "mes.wo.planned",
                  "name": "计划产量",
                  "type": "Int16"
                },
                "label": "计划产量",
                "align": "left",
                "width": "*",
                "function": "sum"
              },
              {
                "type": 1,
                "tag": {
                  "id": "mes.wo.completed",
                  "name": "完工数量",
                  "type": "Int16"
                },
                "label": "完工数量",
                "align": "left",
                "width": "*",
                "function": "sum"
              },
              {
                "type": 1,
                "tag": {
                  "id": "mes.oee.score",
                  "name": "OEE",
                  "type": "Float"
                },
                "label": "OEE",
                "align": "left",
                "width": "*",
                "function": "average"

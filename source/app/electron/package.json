{
    "name": "scadia",
    "version": "0.0.1",
    "description": "开诚智枢 SCADIA - 工业智能中枢 (采集+视频+诊断+预测)",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "package": "electron-builder --dir",
        "dist": "electron-builder",
        "postinstall": "electron-builder install-app-deps"
    },
    "author": "kcylp",
    "license": "MIT",
    "devDependencies": {
        "electron": "39.8.10",
        "electron-builder": "25.1.8"
    },
    "dependencies": {
        "sqlite3": "5.1.7"
    },
    "overrides": {
        "tar": "7.5.20"
    },
    "build": {
        "appId": "com.kcylp.scadia",
        "productName": "开诚智枢 SCADIA",
        "asar": false,
        "files": [
            "main.js",
            "*.html",
            "server/**/*",
            "client/dist/**/*",
            "icons/**/*"
        ],
        "extraResources": [
            {
                "from": "server/node_modules",
                "to": "app/server/node_modules",
                "filter": [
                    "!**/.bin/**"
                ]
            }
        ],
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": ["x64"]
                }
            ],
            "icon": "icons/scadia-logo.ico"
        },
        "linux": {
            "target": [
                {
                    "target": "appimage",
                    "arch": ["x64", "arm64"]
                }
            ],
            "executableName": "scadia",
            "icon": "icons/scadia-logo.png"
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": ["x64", "arm64"]
                }
            ],
            "icon": "icons/scadia-logo.icns"
        }
    }
}
